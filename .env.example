# Home Assistant Base URL (e.g., http://homeassistant.local:8123 or your HA IP:PORT)
HA_URL=http://homeassistant.local:8123

# Long-Lived Access Token generated from Home Assistant (Profile -> Long-Lived Access Tokens)
HA_TOKEN=your_long_lived_access_token_here

# Sync frequency in seconds (default: 60)
SYNC_INTERVAL=60
